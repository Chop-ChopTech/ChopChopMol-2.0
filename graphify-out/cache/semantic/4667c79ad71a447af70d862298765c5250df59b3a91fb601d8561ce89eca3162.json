{"nodes": [{"id": "aws_migration_guide_guide", "label": "ChopChopMol AWS Migration Guide", "file_type": "document", "source_file": "AWS_MIGRATION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aws_migration_guide_ec2_gpu_backend", "label": "EC2 g4dn.xlarge GPU Backend", "file_type": "concept", "source_file": "AWS_MIGRATION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merges the two separate compute deployments (Render CPU + RunPod GPU) into one g4dn.xlarge box running the existing Docker container, cutting moving parts and bills; image built directly on the instance from a git clone to avoid Docker Hub/ECR per the GitHub+AWS-only rule."}, {"id": "aws_migration_guide_dynamodb", "label": "DynamoDB Database (5 tables)", "file_type": "concept", "source_file": "AWS_MIGRATION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Firestore subcollections map to composite primary keys (uid partition key + item id sort key); the browser now talks to the backend instead of directly to the DB so all credentials stay server-side; on-demand capacity avoids planning for a small app."}, {"id": "aws_migration_guide_cognito", "label": "Amazon Cognito Authentication", "file_type": "concept", "source_file": "AWS_MIGRATION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the existing Authorization: Bearer <token> seam and only changes the token issuer; Hosted UI with Authorization Code + PKCE handles Google and email/password without maintaining a custom form; Cognito assigns a new sub so users must be re-keyed by email."}, {"id": "aws_migration_guide_s3_cloudfront", "label": "S3 + CloudFront Frontend Hosting", "file_type": "concept", "source_file": "AWS_MIGRATION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "S3 bucket kept private, reached only via CloudFront Origin Access Control; ACM cert must live in us-east-1 for CloudFront; www is canonical because Squarespace cannot CNAME the apex at CloudFront."}, {"id": "aws_migration_guide_caddy", "label": "Caddy HTTPS Reverse Proxy", "file_type": "concept", "source_file": "AWS_MIGRATION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-obtains/renews Let's Encrypt certs and proxies api.chopchopmol.com to localhost:10000; disables response buffering on SSE streaming endpoints so long ML jobs stream correctly."}, {"id": "aws_migration_guide_data_store", "label": "data_store.py boto3 Data Layer", "file_type": "concept", "source_file": "AWS_MIGRATION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aws_migration_guide_cognito_auth_module", "label": "cognito_auth.py JWT Verifier", "file_type": "concept", "source_file": "AWS_MIGRATION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aws_migration_guide_migration_script", "label": "migrate_firestore_to_dynamodb.py", "file_type": "concept", "source_file": "AWS_MIGRATION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aws_migration_guide_auth_cognito_js", "label": "auth-cognito.js Frontend Auth Module", "file_type": "concept", "source_file": "AWS_MIGRATION_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aws_migration_guide_firestore", "label": "Firebase Firestore Database", "file_type": "concept", "source_file": "AWS_MIGRATION_GUIDE.md", "source_location": null, "source_url": null, "captured_at"