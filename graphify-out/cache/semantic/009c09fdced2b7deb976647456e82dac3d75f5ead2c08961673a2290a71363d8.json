cf_finetuning_guide.pdf", "source_location": "p. 1", "weight": 1.0}, {"source": "demo_mace_pyscf_finetuning_guide_direct_learning", "target": "demo_mace_pyscf_finetuning_guide_delta_learning", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "weight": 1.0}, {"source": "demo_mace_pyscf_finetuning_guide_tldr_checklist", "target": "demo_mace_pyscf_finetuning_guide_core_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 4", "weight": 1.0}, {"source": "demo_mace_pyscf_finetuning_guide", "target": "demo_mace_pyscf_finetuning_guide_tldr_checklist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 4", "weight": 1.0}], "hyperedges": [{"id": "mace_pyscf_finetuning_pipeline", "label": "MACE/PySCF Fine-tuning Pipeline Stages", "nodes": ["demo_mace_pyscf_finetuning_guide_geometry_dataset", "demo_mace_pyscf_finetuning_guide_pyscf_labeling", "demo_mace_pyscf_finetuning_guide_finetuning_strategy", "demo_mace_pyscf_finetuning_guide_active_learning", "demo_mace_pyscf_finetuning_guide_core_loop"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "demo/mace_pyscf_finetuning_guide.pdf"}, {"id": "mace_training_target_choice", "label": "Training Target and Fine-tuning Mode Choices", "nodes": ["demo_mace_pyscf_finetuning_guide_direct_learning", "demo_mace_pyscf_finetuning_guide_delta_learning", "demo_mace_pyscf_finetuning_guide_finetuning_modes"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.8, "source_file": "demo/mace_pyscf_finetuning_guide.pdf"}]}