{"nodes": [{"id": "demo_mace_pyscf_finetuning_guide", "label": "Fine-tuning a MACE MLIP using PySCF \u2014 Practical Guide", "file_type": "document", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1-4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "demo_mace_pyscf_finetuning_guide_mace_mlip", "label": "MACE Interatomic Potential (MLIP)", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "demo_mace_pyscf_finetuning_guide_pyscf", "label": "PySCF Quantum-Chemistry Teacher", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "demo_mace_pyscf_finetuning_guide_core_loop", "label": "Core Fine-tuning Loop", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Iterative loop (generate structures \u2192 PySCF labels \u2192 train MACE \u2192 test \u2192 add hard cases via active learning \u2192 retrain) so the fast surrogate reproduces accurate quantum-chemistry labels."}, {"id": "demo_mace_pyscf_finetuning_guide_direct_learning", "label": "Direct Learning Target", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simplest approach: train MACE to predict PySCF energies and forces directly. Preferred when no decent baseline potential exists."}, {"id": "demo_mace_pyscf_finetuning_guide_delta_learning", "label": "Delta-Learning (\u0394E Correction)", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Train a correction model for \u0394E = E(PySCF) \u2212 E(base); final prediction = base + correction. More data-efficient, converges faster and is more stable when a decent baseline potential already exists."}, {"id": "demo_mace_pyscf_finetuning_guide_geometry_dataset", "label": "Geometry Dataset Construction", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most important step: models fail mainly from lack of coverage. Include near-equilibrium, small distortions, finite-temperature MD snapshots, reaction/transition geometries, and edge cases so the model does not extrapolate wildly."}, {"id": "demo_mace_pyscf_finetuning_guide_pyscf_labeling", "label": "PySCF Labeling (Energies + Gradients)", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1-2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run one consistent PySCF setup (method, basis, charge, spin, convergence) per geometry; store total energy and nuclear gradients where forces = \u2212gradients."}, {"id": "demo_mace_pyscf_finetuning_guide_unit_conversion", "label": "Unit Conversion (Hartree/Bohr \u2192 eV/\u00c5)", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PySCF outputs Hartree and Hartree/Bohr, but MACE/ASE expects eV and eV/\u00c5. 1 Hartree = 27.211386245988 eV; 1 Bohr = 0.529177210903 \u00c5; forces multiplied by (27.211386245988 / 0.529177210903). Sign convention critical: forces are negative gradients."}, {"id": "demo_mace_pyscf_finetuning_guide_storage_format", "label": "MLIP-Friendly Storage Format", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ASE Atoms objects with per-structure energy, forces, optional stress/virial; formats like extended XYZ, .traj, HDF5. Consistency (atom ordering, units, metadata) matters more than format."}, {"id": "demo_mace_pyscf_finetuning_guide_finetuning_strategy", "label": "MACE Fine-tuning Strategy", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loss combines energy + forces with forces weighted much higher; use a lower learning rate than training from scratch; train output head first then unfreeze deeper layers; monitor validation energy MAE (eV/atom) and force RMSE (eV/\u00c5); keep a held-out validation set with difficult geometries."}, {"id": "demo_mace_pyscf_finetuning_guide_two_phase_recipe", "label": "Two-Phase Training Recipe", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase A: freeze most layers and train output head for stability (short run). Phase B: unfreeze more layers and continue with smaller learning rate."}, {"id": "demo_mace_pyscf_finetuning_guide_active_learning", "label": "Active Learning Loop", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run short MD/relaxation with current model, select frames with large forces / instability / model disagreement, recompute with PySCF, append to dataset and retrain. Gives better robustness than adding random data."}, {"id": "demo_mace_pyscf_finetuning_guide_pyscf_pitfalls", "label": "PySCF-Specific Pitfalls", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SCF convergence can fail on distorted geometries (add retries/fallbacks); keep charge and spin consistent; for periodic pyscf.pbc systems watch k-points and basis; filter out non-converged calculations."}, {"id": "demo_mace_pyscf_finetuning_guide_finetuning_modes", "label": "Fine-tuning Modes (Scratch / Domain Adaptation / \u0394-model)", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "From scratch: train MACE only on PySCF data. Domain adaptation: start from pretrained MACE checkpoint and fine-tune on PySCF set. \u0394-model: keep base potential and train only the correction to PySCF."}, {"id": "demo_mace_pyscf_finetuning_guide_tldr_checklist", "label": "TL;DR Practical Checklist", "file_type": "concept", "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "demo_mace_pyscf_finetuning_guide", "target": "demo_mace_pyscf_finetuning_guide_mace_mlip", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "weight": 1.0}, {"source": "demo_mace_pyscf_finetuning_guide", "target": "demo_mace_pyscf_finetuning_guide_pyscf", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "weight": 1.0}, {"source": "demo_mace_pyscf_finetuning_guide", "target": "demo_mace_pyscf_finetuning_guide_core_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "weight": 1.0}, {"source": "demo_mace_pyscf_finetuning_guide_pyscf", "target": "demo_mace_pyscf_finetuning_guide_pyscf_labeling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "weight": 1.0}, {"source": "demo_mace_pyscf_finetuning_guide_pyscf_labeling", "target": "demo_mace_pyscf_finetuning_guide_mace_mlip", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "weight": 1.0}, {"source": "demo_mace_pyscf_finetuning_guide_unit_conversion", "target": "demo_mace_pyscf_finetuning_guide_pyscf_labeling", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 2", "weight": 1.0}, {"source": "demo_mace_pyscf_finetuning_guide_pyscf_labeling", "target": "demo_mace_pyscf_finetuning_guide_storage_format", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 2", "weight": 1.0}, {"source": "demo_mace_pyscf_finetuning_guide_geometry_dataset", "target": "demo_mace_pyscf_finetuning_guide_pyscf_labeling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 1", "weight": 1.0}, {"source": "demo_mace_pyscf_finetuning_guide_two_phase_recipe", "target": "demo_mace_pyscf_finetuning_guide_finetuning_strategy", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/mace_pyscf_finetuning_guide.pdf", "source_location": "p. 2", "weight": 1.0}, {"source": "demo_mace_pyscf_finetuning_guide_finetuning_strategy", "t